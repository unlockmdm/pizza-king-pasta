{
  // Cloudflare Workers (free plan): serves the built site from ./dist and runs /api/pay.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pizza-king-pasta",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  // Keep variables added in the dashboard (wrangler deploy would otherwise remove them).
  "keep_vars": true,
  // Custom domain (zone lives in this Cloudflare account). Cloudflare creates the DNS records and SSL cert.
  "routes": [
    { "pattern": "pizzakingandpasta.ca", "custom_domain": true },
    { "pattern": "www.pizzakingandpasta.ca", "custom_domain": true }
  ],
  // Non-secret Square settings: LIVE (production) since 2026-11-11. Local dev uses sandbox via .env.local.
  // The location ID is public; it is also in the browser bundle.
  // SQUARE_ACCESS_TOKEN stays a dashboard secret and is never committed.
  "vars": {
    "SQUARE_ENV": "production",
    "VITE_SQUARE_LOCATION_ID": "LM53V6ARW3CW5"
  },
  // Payment attempts per visitor (IP) per minute, to slow down card-testing bots.
  "ratelimits": [
    { "name": "PAY_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  }
}
